# Render all ${...} parameters offline, review, then nginx -t on the exact image.
limit_req_zone $binary_remote_addr zone=enterprise_rate:10m rate=${AIGUARD_RATE};
limit_conn_zone $binary_remote_addr zone=enterprise_concurrency:10m;
server {
    listen 443 ssl;
    server_name ${AIGUARD_TLS_HOST};
    ssl_certificate ${AIGUARD_CERTIFICATE_FILE};
    ssl_certificate_key ${AIGUARD_CERTIFICATE_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;
    client_body_timeout 10s;
    send_timeout 30s;
    access_log off;
    error_log /dev/null crit;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        limit_req zone=enterprise_rate burst=${AIGUARD_BURST} nodelay;
        limit_conn enterprise_concurrency ${AIGUARD_CONCURRENCY};
        proxy_pass http://127.0.0.1:${AIGUARD_LOOPBACK_PORT};
        proxy_set_header Host ${AIGUARD_TLS_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_redirect off;
        proxy_hide_header Server;
    }
}
# Add a rejecting default TLS server using the operator's certificate policy.
# Only this local proxy can reach the runtime port; never trust arbitrary headers.
