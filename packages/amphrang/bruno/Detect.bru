meta {
  name: Detect
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/detect
  body: json
  auth: none
}

headers {
  X-Amphrang-Contract-Version: 2
}

body:json {
  {
    "text": "ผมชื่อ นายสมชาย ใจดี โทร 081-234-5678 อีเมล somchai@example.com"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("detects at least one entity", function () {
    expect(res.getBody().detected_entity_count).to.be.at.least(1);
  });
}
