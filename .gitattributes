# The blind-set blob is byte-exact: its lock records a SHA-256 of the file and
# an HMAC covers its lines, so any line-ending normalization on checkout breaks
# both. Treat it as binary everywhere.
benchmark/data/*.enc -text

# The blind audit log and lock are hashed per-entry over JSON content (line
# endings excluded), but keep them LF so every platform sees identical files.
benchmark/data/blind-scores.jsonl text eol=lf
benchmark/data/*.lock.json text eol=lf

# The broader PDPA context corpus is also byte-exact authenticated blinding.
research/pdpa-coverage/*.enc -text
# Keep measured bytes and accept CRLF as line endings in whitespace checks.
research/pdpa-coverage/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
research/pdpa-coverage/annotation-guide-at-freeze.md -text
docs/research/pdpa-coverage-plan.md -text

# Migration fingerprints must survive checkout on every supported platform.
pii_redactor/governance/migrations/*.sql text eol=lf

# Preserve copied qualification records and accept their observed CRLF bytes.
docs/acceptance/enterprise/M01-integrated-artifact*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/acceptance/enterprise/M01-receipt-artifact*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/acceptance/enterprise/M02-receipt-installed-pdf*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# New compact evidence records use stable LF bytes on every checkout.
docs/acceptance/enterprise/M03-controlled-performance.json text eol=lf
docs/implementation/2026-11-03-branch-preservation.json text eol=lf

# Gemma seed JSON is hashed by exact bytes in tests/test_yrss_claim_map.py.
# A Windows checkout with core.autocrlf=true rewrites LF to CRLF and the
# recorded digest no longer matches. Keep these evidence files LF.
docs/benchmark/runs/*.json text eol=lf

# The v2 template files are hashed by exact bytes in their lock files.
# Keep them LF so a Windows checkout does not change the digest.
benchmark/data/yrss-v2/*.jsonl text eol=lf

# Official form probes are byte-exact PDF artifacts.
benchmark/data/probe/gov_forms/sanitized/*.pdf binary
