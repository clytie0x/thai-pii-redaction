{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aiguard.synthetic-section26-signals/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "semantics", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "corpus_id": {"const": "aiguard-section26-heuristic-v1"},
    "semantics": {"const": "heuristic keyword signal evaluation; not PDPA compliance accuracy"},
    "cases": {
      "type": "array",
      "minItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "text", "expected_categories", "action", "phenomena", "provenance"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^S[0-9]{4}$"},
          "text": {"type": "string", "minLength": 1},
          "expected_categories": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "uniqueItems": true
          },
          "action": {"enum": ["review_signal", "no_signal", "ambiguous"]},
          "phenomena": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
            "uniqueItems": true
          },
          "provenance": {"type": "string", "pattern": "^constructed-template:[a-z0-9_-]+$"}
        }
      }
    }
  }
}
